{
  "expo": {
    "name": "Blood Lab",
    "slug": "ai-blood-report-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bloodai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bloodai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F7F9F9"
      },
      "package": "com.bloodai.app",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F9F9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Blood Lab needs your photos so you can pick a blood report you have already saved.",
          "cameraPermission": "Blood Lab needs your camera so you can photograph a blood report.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d953ffa6-6bb8-45e8-a956-fa6f77dab0e4"
      }
    }
  }
}
