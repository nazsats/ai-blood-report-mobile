{
  "expo": {
    "name": "Plainly",
    "slug": "ai-blood-report-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bloodai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bloodai.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Plainly uses motion data to count your daily steps."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F7F9F9"
      },
      "package": "com.bloodai.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "ACTIVITY_RECOGNITION"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F9F9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Plainly needs your photos so you can pick a blood report you have already saved.",
          "cameraPermission": "Plainly needs your camera so you can photograph a blood report."
        }
      ],
      "expo-document-picker",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Plainly uses your location to show local air quality."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Plainly uses your device's motion sensor to count steps."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
